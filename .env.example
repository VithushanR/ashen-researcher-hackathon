# Copy this file to .env and fill in what you need.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# .env is in .gitignore and must never be committed. A key leaked in an old
# commit stays leaked -- judges read the full history. If one does leak, revoke
# it in the provider dashboard first, then deal with the history.
#
# Every value below has a working default. The app runs with no .env at all,
# serving fixture answers, which is enough to see the whole interface.


# ---------------------------------------------------------------------------
# API keys
# ---------------------------------------------------------------------------

# Google Gemini, for the LLM calls. Only needed once the real pipeline is wired.
GEMINI_API_KEY=your_gemini_api_key_here

# Voyage AI, for embeddings and reranking (Person A's retrieval).
VOYAGE_API_KEY=your_voyage_api_key_here


# ---------------------------------------------------------------------------
# Pipeline wiring
# ---------------------------------------------------------------------------

# auto = real pipeline if importable, fixtures otherwise (default)
# real = real only, fail loudly if missing -- use in CI
# stub = fixtures even when the real pipeline exists -- use for UI work
ASHEN_PIPELINE=auto

# Where Person B's research() lives, as module:function.
#
# "agent.loop", not "src.agent.loop". Person B's modules import each other as
# `from agent.state import ...`, so they are addressed relative to src/, which
# pipeline.py puts on sys.path. Using the "src." spelling loads every agent
# module a second time under a different name, which makes two incompatible
# copies of ResearchState.
ASHEN_RESEARCH_TARGET=agent.loop:research

# Where Person C's compose_answer() lives, as module:function. Person C's
# modules use relative imports, so this one is addressed from the repo root --
# the inconsistency with the line above is real, not a typo.
ASHEN_COMPOSE_TARGET=src.answer.composer:compose_answer

# Where Person A's one-shot baseline_rag() lives, for the demo contrast.
ASHEN_BASELINE_TARGET=src.retrieval.baseline:baseline_rag


# ---------------------------------------------------------------------------
# Paths and addresses
# ---------------------------------------------------------------------------

# Where standalone image files live, for Person B's vision fallback. Only read
# when an image chunk actually triggers it.
ASHEN_IMAGE_DIR=corpus/images

# The document archive, for resolving a citation back to its source file.
# Auto-detected if it sits beside the repo; set it explicitly otherwise.
ASHEN_ARCHIVE_ROOT=D:/Hackathon/Ashen_Era_Archive

# Where the Streamlit UI looks for the backend.
ASHEN_API_BASE=http://127.0.0.1:8000

# Where cached API responses are stored. Safe to delete at any time.
ASHEN_CACHE_DIR=.cache/ashen


# ---------------------------------------------------------------------------
# Models (spec section 5 -- cheap model for loop steps, strong for synthesis)
# ---------------------------------------------------------------------------

# Fast role: B sufficiency/conflict detection and C validation.
GEMINI_FAST_MODEL=gemini-2.5-flash

# Synthesis role: C final answer synthesis.
GEMINI_SYNTHESIS_MODEL=gemini-2.5-flash

# Vision role: B image fallback.
GEMINI_VISION_MODEL=gemini-2.5-flash


# ---------------------------------------------------------------------------
# Demo and debugging
# ---------------------------------------------------------------------------

# Set to 1 to bypass the response cache entirely. Use this when recording the
# "question nobody has tested" segment, so the run is provably live.
# ASHEN_NO_CACHE=1

# Seconds between fixture trace steps. 0 for fast tests, 0.8 for a demo where
# the trace should visibly fill in round by round.
ASHEN_STUB_DELAY=0.8

# Seconds the UI waits for a full research run before giving up.
ASHEN_UI_TIMEOUT=300

# DEBUG, INFO, WARNING, ERROR.
ASHEN_LOG_LEVEL=INFO
